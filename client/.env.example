# Backend HTTP origin only (client code appends `/api/...`). A trailing `/api` is stripped if present.
# Match `PORT` in server/.env.example (default 4000). Use 5000 if your API listens there.
VITE_API_URL=http://localhost:4000

# Optional: Socket.IO origin. Defaults to `VITE_API_URL`, then same-origin + Vite proxy.
VITE_SOCKET_URL=http://localhost:4000

# Optional: public site URL for SEO (canonical, hreflang, JSON-LD). Falls back to window.location.origin.
# VITE_SITE_URL=https://example.com

# Optional integrations (used when wired in the app)
VITE_GOOGLE_MAPS_KEY=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Arabic is the platform default; comma-separated list of enabled UI languages (ar, en).
VITE_DEFAULT_LANGUAGE=ar
VITE_SUPPORTED_LANGUAGES=ar,en
