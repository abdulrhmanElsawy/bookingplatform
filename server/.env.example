NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/growth-world
REDIS_URL=redis://localhost:6379
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From domain must be allowed by the relay (SPF/DKIM / provider rules). Many hosts reject
# arbitrary From addresses; e.g. Gmail: use the authenticated account or a verified alias.
SMTP_FROM=no-reply@example.com

# Local listing image storage (POST /api/uploads/listing-image)
UPLOAD_DIR=./uploads
# Leave empty in local dev for relative /uploads/... URLs (Vite proxies /uploads → API).
# Set to your public API/CDN origin in production, e.g. https://api.example.com
PUBLIC_UPLOAD_BASE_URL=

# Legacy — not used when saving listing images locally
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=growth-world
