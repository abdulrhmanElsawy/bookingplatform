{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "tsx watch src/index.ts",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "tsc && node scripts/copy-i18n.mjs && node scripts/copy-email-templates.mjs",
    "prestart": "node scripts/ensure-shared.mjs",
    "start": "node dist/index.js",
    "install:deps": "npm install --prefix ../shared && npm install",
    "test": "jest --config jest.config.cjs",
    "seed:categories": "tsx src/database/runSeedCategories.ts",
    "seed:dev": "tsx src/database/runSeedDev.ts",
    "repair:listing-images": "tsx src/database/runRepairListingImages.ts",
    "repair:listing-images:dry": "tsx src/database/runRepairListingImages.ts --dry-run",
    "migrate:local-to-atlas": "tsx src/database/runMigrateLocalToAtlas.ts"
  },
  "dependencies": {
    "@growth-world/shared": "file:../shared",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^6.4.21",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
